{
  "name": "immi-server",
  "version": "0.1.0",
  "description": "Immigration form processing server using Anthropic AI",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "build-map": "ts-node src/services/buildFormMap.ts",
    "fill-form": "ts-node src/services/fillForm.ts",
    "extract-pdf": "ts-node src/services/extractPdf.ts",
    "load": "ts-node src/services/manualLoad.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.6.2",
    "mongoose": "^8.4.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
